# ============================================
# CodeBuddy 模型 API Key 配置说明
# ============================================
# 复制此文件为 .env（不上传 Git），然后填入真实 Key
#
# 使用方法（PowerShell）：
#   [Environment]::SetEnvironmentVariable("OPENAI_API_KEY", "sk-你的key", "User")
#   [Environment]::SetEnvironmentVariable("DASHSCOPE_API_KEY", "sk-sp-你的key", "User")
#
# 设置后重启 CodeBuddy 即可生效
# ============================================

# OpenAI GPT-4o
OPENAI_API_KEY=sk-your-openai-api-key

# 阿里云百炼 Coding Plan（格式: sk-sp-xxxxx）
# Base URL: https://coding.dashscope.aliyuncs.com/v1/chat/completions
DASHSCOPE_API_KEY=sk-sp-your-dashscope-api-key
