[resource]
script = ExtResource("1")
rules_version = "gdd-v1-demo-1"
rules = {"region_ap": 6, "exploration_regions_per_run": 3, "optional_activities": 3, "party_max": 3, "start_gold": 15, "level_cap": 4, "rest_heal_pct": 50, "merchant_heal_pct": 80, "merchant_heal_gold": 25, "merchant_gear_gold": 30, "chest_gold": 15, "patrol_gold": 12, "repeat_hp_step_pct": 15, "repeat_atk_step_pct": 10, "repeat_step_cap": 2, "fine_stat_mult": 1.15, "boss_fine_chance_pct": 30, "burn_damage_per_stack": 7, "burn_stack_cap": 3, "burn_ticks": 3, "mark_armor_reduction": 4, "mark_target_actions": 3, "shield_max_hp_pct": 50, "enrage_start_round": 9, "enrage_atk_step_pct": 15, "battle_round_cap": 30, "regen_heal": 6, "fury_atk_pct": 15, "fury_armor": -2, "resolve_armor": 3, "resolve_speed": -2, "priest_heal_threshold_pct": 70, "hero_skill_slots": 1, "hero_passive_slots": 1}
regions = Array[Resource]([ExtResource("2"), ExtResource("3"), ExtResource("4"), ExtResource("5"), ExtResource("6"), ExtResource("7"), ExtResource("8"), ExtResource("9"), ExtResource("10")])
units = Array[Resource]([ExtResource("11"), ExtResource("12"), ExtResource("13"), ExtResource("14"), ExtResource("15"), ExtResource("16"), ExtResource("17"), ExtResource("18"), ExtResource("19"), ExtResource("20"), ExtResource("21"), ExtResource("22")])
activities = Array[Resource]([ExtResource("23"), ExtResource("24"), ExtResource("25"), ExtResource("26"), ExtResource("27"), ExtResource("28"), ExtResource("29")])
equipment = Array[Resource]([ExtResource("30"), ExtResource("31"), ExtResource("32")])
affixes = Array[Resource]([ExtResource("33"), ExtResource("34"), ExtResource("35")])
sets = Array[Resource]([ExtResource("36"), ExtResource("37"), ExtResource("38"), ExtResource("39"), ExtResource("40"), ExtResource("41")])
skills = Array[Resource]([ExtResource("42"), ExtResource("43"), ExtResource("44"), ExtResource("45"), ExtResource("46"), ExtResource("47")])
events = Array[Resource]([ExtResource("48"), ExtResource("49"), ExtResource("50"), ExtResource("51"), ExtResource("52"), ExtResource("53")])
